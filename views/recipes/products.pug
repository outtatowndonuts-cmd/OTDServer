//- h1 Products (removed for SPA)
  a.btn.btn-primary(href='/recipes/products/new') Add Product
  table.table.table-striped.mt-3
    thead
      tr
        th Name
        th Components
        th Price
        th Actions
    tbody
      each product in products
        tr
          td= product.name
          td
            ul
              each comp in product.components
                li #{comp.type}: #{comp.ref.name} (#{comp.quantity} #{comp.unit})
          td= product.price
          td
            a.btn.btn-sm.btn-secondary(href=`/recipes/products/${product._id}/edit`) Edit
            form(action=`/recipes/products/${product._id}/delete`, method='post', style='display:inline')
              if typeof _csrf !== 'undefined'
                input(type='hidden', name='_csrf', value=_csrf)
              button.btn.btn-sm.btn-danger(type='submit') Delete
