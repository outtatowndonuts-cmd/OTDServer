nav.navbar.navbar-expand-lg.navbar-dark
  .container
    a.navbar-brand(href='/')
      | Outta Town Donuts
    button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarColor01', aria-controls='navbarColor01', aria-expanded='false', aria-label='Toggle navigation')
      span.navbar-toggler-icon
    #navbarColor01.collapse.navbar-collapse
      ul.navbar-nav.me-auto.mb-2.mb-lg-0
        li.nav-item
          a.nav-link(class=title === 'Home' ? 'active' : '', href='/') Dashboard
        li.nav-item
          a.nav-link(href='/pos') POS
        li.nav-item
          a.nav-link(href='/orders') Orders
        li.nav-item
          a.nav-link(href='/recipes') Recipes
        li.nav-item
          a.nav-link(href='/inventory') Inventory
        li.nav-item
          a.nav-link(href='/admin') Admin
        li.nav-item
          a.nav-link(href='/shop') Shop

      form.d-flex
        if !user
          a.btn.btn-outline-light.me-2(href='/login') Login
          a.btn.btn-primary(href='/signup') Create Account
        else
          a.btn.btn-primary.me-2(href='/account') My Account
          a.btn.btn-outline-danger(href='/logout') Sign out
