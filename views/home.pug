extends layout
block head
  //- Opengraph tags
  meta(property='og:title', content='Outta Town Donuts Business OS')
  meta(property='og:description', content='Admin dashboard for Outta Town Donuts business operations.')
  meta(property='og:type', content='website')
  meta(property='og:url', content=siteURL)
  meta(property='og:image', content=`${siteURL}/bootstrap-logo.svg`)
  //- Twitter Card tags
  meta(name='twitter:card', content='summary_large_image')
  meta(name='twitter:title', content='Outta Town Donuts Business OS')
  meta(name='twitter:description', content='Admin dashboard for Outta Town Donuts business operations.')
  meta(name='twitter:image', content=`${siteURL}/bootstrap-logo.svg`)

block content
  h1 Outta Town Donuts — Admin Dashboard
  p.lead Welcome, Administrator. Manage operations, sales, and production for Outta Town Donuts from this central hub.
  hr
  .row.row-cols-1.row-cols-md-3.g-4
    .col.d-flex
      .card.shadow-sm.w-100
        .card-body.d-flex.flex-column
          h3 POS
          p.flex-grow-1 Access the Point of Sale system for in-person transactions.
          a.btn.btn-primary.mt-auto(href='/pos', role='button') Launch POS
    .col.d-flex
      .card.shadow-sm.w-100
        .card-body.d-flex.flex-column
          h3 Shop
          p.flex-grow-1 Visit the public online shop.
          a.btn.btn-success.mt-auto(href='/shop', role='button') Shop
    .col.d-flex
      .card.shadow-sm.w-100
        .card-body.d-flex.flex-column
          h3 Orders
          p.flex-grow-1 Review and manage all customer orders, both online and in-store.
          a.btn.btn-primary.mt-auto(href='/orders', role='button') Orders
    .col.d-flex
      .card.shadow-sm.w-100
        .card-body.d-flex.flex-column
          h3 Recipes
          p.flex-grow-1 Oversee recipes and production tracking for your kitchen.
          a.btn.btn-primary.mt-auto(href='/recipes', role='button') Recipes
    .col.d-flex
      .card.shadow-sm.w-100
        .card-body.d-flex.flex-column
          h3 Inventory
          p.flex-grow-1 Track inventory and supplies.
          a.btn.btn-primary.mt-auto(href='/inventory', role='button') Inventory
    .col.d-flex
      .card.shadow-sm.w-100
        .card-body.d-flex.flex-column
          h3 Admin
          p.flex-grow-1 Manage staff, roles, and system settings.
          a.btn.btn-primary.mt-auto(href='/admin', role='button') Admin
  hr
  p.text-muted.text-center.mt-4
    | For support or to add new modules, contact your system administrator.
