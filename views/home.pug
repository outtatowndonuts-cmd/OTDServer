extends layout
block head
  //- Opengraph tags
  meta(property='og:title', content='Outta Town Donuts Business OS')
  meta(property='og:description', content='Admin dashboard for Outta Town Donuts business operations.')
  meta(property='og:type', content='website')
  meta(property='og:url', content=siteURL)
  meta(property='og:image', content=`${siteURL}/bootstrap-logo.svg`)
  //- Twitter Card tags
  meta(name='twitter:card', content='summary_large_image')
  meta(name='twitter:title', content='Outta Town Donuts Business OS')
  meta(name='twitter:description', content='Admin dashboard for Outta Town Donuts business operations.')
  meta(name='twitter:image', content=`${siteURL}/bootstrap-logo.svg`)

block content
  h1 Outta Town Donuts — Admin Dashboard
  p.lead Welcome, Administrator. Manage operations, sales, and production for Outta Town Donuts from this central hub.
  hr
  .row
    .col-md-4
      .card.mb-4.shadow-sm
        .card-body
          h3 POS
          p Access the Point of Sale system for in-person transactions.
          p
            a.btn.btn-primary(href='/pos', role='button') Launch POS
    .col-md-4
      .card.mb-4.shadow-sm
        .card-body
          h3 Orders
          p Review and manage all customer orders, both online and in-store.
          p
            a.btn.btn-primary(href='/orders', role='button') Orders
    .col-md-4
      .card.mb-4.shadow-sm
        .card-body
          h3 Recipes
          p Oversee recipes and production tracking for your kitchen.
          p
            a.btn.btn-primary(href='/recipes', role='button') Recipes
  .row.mt-4
    .col-md-4
      .card.mb-4.shadow-sm
        .card-body
          h3 Inventory
          p Track inventory and supplies.
          p
            a.btn.btn-primary(href='/inventory', role='button') Inventory
    .col-md-4
      .card.mb-4.shadow-sm
        .card-body
          h3 Admin
          p Manage staff, roles, and system settings.
          p
            a.btn.btn-secondary(href='#', role='button', disabled) Admin
  hr
  p.text-muted.text-center.mt-4
    | For support or to add new modules, contact your system administrator.
