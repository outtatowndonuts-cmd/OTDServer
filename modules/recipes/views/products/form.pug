- var isEdit = item != null;
- var formTitle = isEdit ? 'Edit Product' : 'Add Product';
- var formAction = isEdit ? '/recipes/products/' + item._id : '/recipes/products';
- var pType = isEdit ? item.productType || 'simple' : 'simple';

.d-flex.justify-content-between.align-items-center.mb-4
  h5.mb-0= formTitle
  button.btn.btn-outline-secondary.btn-sm(type='button', data-action='cancel')
    i.fas.fa-arrow-left.me-1
    | Back

form#section-form(action=formAction, method='POST')
  input(type='hidden', name='_csrf', value=_csrf)

  //- Core Fields
  .row.g-3.mb-4
    .col-md-6
      label.form-label.fw-semibold(for='pr-name') Product Name *
      input#pr-name.form-control(type='text', name='name', value=isEdit ? item.name : '', required, placeholder='e.g. Strawberry Sprinkle Donut')

    .col-md-3
      label.form-label.fw-semibold(for='pr-sku') SKU
      input#pr-sku.form-control(type='text', name='sku', value=isEdit ? item.sku || '' : '', placeholder='Optional')

    .col-md-2
      label.form-label.fw-semibold(for='pr-price') Price ($)
      input#pr-price.form-control(type='number', name='price', step='0.01', min='0', value=isEdit ? item.price || '' : '')

    .col-md-1.d-flex.flex-column.justify-content-end
      .form-check.mb-2
        input#pr-active.form-check-input(type='checkbox', name='isActive', value='true', checked=isEdit ? item.isActive !== false : true)
        label.form-check-label(for='pr-active') Active

  //- Product Type
  .mb-4
    label.form-label.fw-semibold Product Type
    .d-flex.gap-3
      .form-check
        input#pt-simple.form-check-input(type='radio', name='productType', value='simple', checked=pType === 'simple')
        label.form-check-label(for='pt-simple')
          strong Simple
          small.text-muted.ms-1 - assembled from a kitchen batch + finishing
      .form-check
        input#pt-bundle.form-check-input(type='radio', name='productType', value='bundle', checked=pType === 'bundle')
        label.form-check-label(for='pt-bundle')
          strong Bundle
          small.text-muted.ms-1 - grouped from other products (e.g. half-dozen box)

  //- Simple product fields
  #simple-fields(style=pType === 'bundle' ? 'display:none' : '')
    .card.mb-4.border-primary-subtle
      .card-header.bg-primary-subtle.fw-semibold.text-primary-emphasis
        i.fas.fa-fire.me-2
        | Back of House - Kitchen Base
      .card-body
        p.text-muted.small.mb-3
          | Select the kitchen recipe that produces the base for this product.
          | A production order will build batches of this recipe; the assembly
          | step converts those batches into finished display-case products.
        .row.g-3
          .col-md-8
            label.form-label(for='pr-recipe') Base Recipe
            select#pr-recipe.form-select(name='recipe')
              option(value='') -- none --
              each rec in allRecipes
                - var sel = isEdit && item.recipe && (item.recipe._id || item.recipe).toString() === rec._id.toString();
                option(value=rec._id, selected=sel)= rec.name + ' (yields ' + (rec.yield || '?') + ' ' + (rec.yieldUnit || 'each') + ')'
          .col-md-4
            label.form-label(for='pr-baseqty') Kitchen units per product
            input#pr-baseqty.form-control(type='number', name='baseQty', step='0.001', min='0.001', value=isEdit ? item.baseQty || 1 : 1, placeholder='1')
            small.text-muted How many batch units make one of this product (usually 1).

    .card.mb-4.border-warning-subtle
      .card-header.bg-warning-subtle.fw-semibold.text-warning-emphasis
        i.fas.fa-paint-brush.me-2
        | Front of House - Finishing / Assembly
      .card-body
        p.text-muted.small.mb-3
          | Ingredients and supplies added during front-of-house finishing
          | (toppings, glazes, decorations, packaging, etc.).
        .d-flex.justify-content-between.align-items-center.mb-2
          span.fw-semibold.small.text-uppercase.text-muted Finishing Components
          button.btn.btn-outline-secondary.btn-sm(type='button', data-action='add-row', data-target='finishing-rows')
            i.fas.fa-plus.me-1
            | Add

        .row.gx-2.text-muted.small.mb-1
          .col-3 Type
          .col-4 Item
          .col-2 Qty
          .col-2 Unit
          .col-1

        #finishing-rows
          if isEdit && item.finishingComponents && item.finishingComponents.length
            each fc, idx in item.finishingComponents
              .row.gx-2.mb-2.item-row
                .col-3
                  select.form-select.form-select-sm(name=`finishingComponents[${idx}][type]`, data-role='fc-type')
                    option(value='Ingredient', selected=fc.type === 'Ingredient') Ingredient
                    option(value='Supply', selected=fc.type === 'Supply') Supply
                .col-4
                  select.form-select.form-select-sm(name=`finishingComponents[${idx}][ref]`, data-role='fc-ref')
                    each ing in allIngredients
                      - var sel = fc.ref && fc.ref.toString() === ing._id.toString();
                      option(value=ing._id, data-kind='Ingredient', selected=sel)= ing.name
                    each sup in allSupplies
                      - var sel = fc.ref && fc.ref.toString() === sup._id.toString();
                      option(value=sup._id, data-kind='Supply', selected=sel)= sup.name
                .col-2
                  input.form-control.form-control-sm(type='number', step='0.001', min='0', name=`finishingComponents[${idx}][quantity]`, value=fc.quantity || '')
                .col-2
                  input.form-control.form-control-sm(type='text', name=`finishingComponents[${idx}][unit]`, value=fc.unit || '', placeholder='oz, each...')
                .col-1
                  button.btn.btn-sm.btn-outline-danger(type='button', data-action='remove-row') x
          else
            .row.gx-2.mb-2.item-row
              .col-3
                select.form-select.form-select-sm(name='finishingComponents[0][type]', data-role='fc-type')
                  option(value='Ingredient') Ingredient
                  option(value='Supply') Supply
              .col-4
                select.form-select.form-select-sm(name='finishingComponents[0][ref]', data-role='fc-ref')
                  each ing in allIngredients
                    option(value=ing._id, data-kind='Ingredient')= ing.name
                  each sup in allSupplies
                    option(value=sup._id, data-kind='Supply')= sup.name
              .col-2
                input.form-control.form-control-sm(type='number', step='0.001', min='0', name='finishingComponents[0][quantity]')
              .col-2
                input.form-control.form-control-sm(type='text', name='finishingComponents[0][unit]', placeholder='oz, each...')
              .col-1
                button.btn.btn-sm.btn-outline-danger(type='button', data-action='remove-row') x

  //- Bundle product fields
  #bundle-fields(style=pType === 'simple' ? 'display:none' : '')
    .card.mb-4.border-info-subtle
      .card-header.bg-info-subtle.fw-semibold.text-info-emphasis
        i.fas.fa-boxes.me-2
        | Bundle Components
      .card-body
        p.text-muted.small.mb-3
          | Select the products (and quantities) that make up this bundle.
          | When this bundle is sold, each component product's display-case
          | inventory will be decremented.
        .d-flex.justify-content-between.align-items-center.mb-2
          span.fw-semibold.small.text-uppercase.text-muted Component Products
          button.btn.btn-outline-secondary.btn-sm(type='button', data-action='add-row', data-target='bundle-rows')
            i.fas.fa-plus.me-1
            | Add

        .row.gx-2.text-muted.small.mb-1
          .col-7 Product
          .col-3 Quantity
          .col-2

        #bundle-rows
          if isEdit && item.bundleItems && item.bundleItems.length
            each bi, idx in item.bundleItems
              .row.gx-2.mb-2.item-row
                .col-7
                  select.form-select.form-select-sm(name=`bundleItems[${idx}][product]`)
                    each prod in allProducts
                      if !isEdit || prod._id.toString() !== item._id.toString()
                        - var bpid = bi.product && (bi.product._id || bi.product).toString();
                        option(value=prod._id, selected=bpid === prod._id.toString())= prod.name
                .col-3
                  input.form-control.form-control-sm(type='number', step='1', min='1', name=`bundleItems[${idx}][quantity]`, value=bi.quantity || 1)
                .col-2
                  button.btn.btn-sm.btn-outline-danger(type='button', data-action='remove-row') x
          else
            .row.gx-2.mb-2.item-row
              .col-7
                select.form-select.form-select-sm(name='bundleItems[0][product]')
                  each prod in allProducts
                    if !isEdit || prod._id.toString() !== (item && item._id ? item._id.toString() : '')
                      option(value=prod._id)= prod.name
              .col-3
                input.form-control.form-control-sm(type='number', step='1', min='1', name='bundleItems[0][quantity]', value='1')
              .col-2
                button.btn.btn-sm.btn-outline-danger(type='button', data-action='remove-row') x

  //- Notes
  .row.g-3.mt-1
    .col-12
      label.form-label.fw-semibold(for='pr-notes') Notes
      textarea#pr-notes.form-control(name='notes', rows='2', placeholder='Optional...')
        = isEdit ? item.notes || '' : ''

  //- Costing Section
  .card.mt-4.border-success-subtle
    .card-header.bg-success-subtle.fw-semibold.text-success-emphasis
      i.fas.fa-calculator.me-2
      | Costing & Pricing
    .card-body
      .row.g-3
        .col-md-4
          label.form-label(for='pr-labor') Labor Cost ($/unit)
          input#pr-labor.form-control(type='number', name='laborCost', step='0.01', min='0', value=isEdit ? item.laborCost || 0 : defaults ? defaults.defaultLaborCost || 0 : 0, placeholder='0.00')
        .col-md-4
          label.form-label(for='pr-overhead') Overhead ($/unit)
          input#pr-overhead.form-control(type='number', name='overheadCost', step='0.01', min='0', value=isEdit ? item.overheadCost || 0 : defaults ? defaults.defaultOverheadCost || 0 : 0, placeholder='0.00')
        .col-md-4
          label.form-label(for='pr-margin') Target Margin (%)
          input#pr-margin.form-control(type='number', name='targetMarginPct', step='1', min='0', max='99', value=isEdit ? item.targetMarginPct || 30 : defaults ? defaults.defaultMarginPct || 30 : 30)

      if costing && !costing.canCalculate
        .alert.alert-warning.mt-2.py-2.small
          i.fas.fa-exclamation-triangle.me-1
          | Some components are missing cost data -- their contribution will show as $0.00 below.

      hr.my-3
      .row.g-3
        .col-md-6
          h6.text-muted.small.text-uppercase.fw-semibold.mb-2 Cost Breakdown
          table.table.table-sm.table-borderless.mb-0
            tbody
              tr
                td Component Cost
                td.text-end
                  if costing
                    = '$' + (costing.ingredientCost || 0).toFixed(3)
                  else
                    span.text-muted --
              tr
                td Labor
                td.text-end
                  if costing
                    = '$' + (costing.laborCost || 0).toFixed(2)
                  else
                    span.text-muted --
              tr
                td Overhead
                td.text-end
                  if costing
                    = '$' + (costing.overheadCost || 0).toFixed(2)
                  else
                    span.text-muted --
              tr.fw-bold.border-top
                td Total COGS
                td.text-end
                  if costing
                    = '$' + (costing.totalCOGS || 0).toFixed(3)
                  else
                    span.text-muted --
        .col-md-6
          h6.text-muted.small.text-uppercase.fw-semibold.mb-2 Pricing Analysis
          table.table.table-sm.table-borderless.mb-0
            tbody
              tr
                td Selling Price
                td.text-end
                  if costing && costing.price > 0
                    = '$' + costing.price.toFixed(2)
                  else
                    span.text-muted --
              tr
                td Gross Margin
                td.text-end
                  if costing && costing.margin !== null && costing.margin !== undefined
                    - var mc = costing.margin < 0 ? 'text-danger' : costing.margin < 20 ? 'text-warning' : 'text-success';
                    span(class=mc)= costing.margin.toFixed(1) + '%'
                  else
                    span.text-muted --
              tr.border-top
                td Suggested Price
                td.text-end
                  if costing && costing.suggestedPrice > 0
                    small.text-muted at&nbsp;
                    = costing.targetMargin + '% margin: '
                    strong= '$' + costing.suggestedPrice.toFixed(2)
                  else
                    span.text-muted --

  .mt-4.d-flex.gap-2
    button.btn.btn-primary(type='submit')
      i.fas.fa-save.me-1
      = isEdit ? 'Save Changes' : 'Add Product'
    button.btn.btn-outline-secondary(type='button', data-action='cancel') Cancel

script.
  (function () {
    var radios = document.querySelectorAll('input[name="productType"]');
    function toggleSections() {
      var val = document.querySelector('input[name="productType"]:checked');
      val = val ? val.value : 'simple';
      document.getElementById('simple-fields').style.display = val === 'simple' ? '' : 'none';
      document.getElementById('bundle-fields').style.display = val === 'bundle' ? '' : 'none';
    }
    radios.forEach(function (r) {
      r.addEventListener('change', toggleSections);
    });
  })();
