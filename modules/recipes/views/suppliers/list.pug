.d-flex.justify-content-between.align-items-center.mb-4
  h4.mb-0
    i.fas.fa-truck.me-2.text-info
    | Suppliers
  button.btn.btn-primary(type='button', data-action='new-form', data-section='suppliers')
    i.fas.fa-plus.me-1
    | Add Supplier

if suppliers && suppliers.length
  .table-responsive
    table.table.table-hover.align-middle
      thead.table-light
        tr
          th Name
          th Contact
          th Notes
          th.text-end Actions
      tbody
        each item in suppliers
          tr
            td
              strong= item.name
            td= item.contact || '—'
            td
              if item.notes
                span.text-truncate= item.notes
              else
                span.text-muted —
            td.text-end
              button.btn.btn-sm.btn-outline-secondary.me-1(type='button', data-action='edit-form', data-section='suppliers', data-id=item._id.toString()) Edit
              button.btn.btn-sm.btn-outline-danger(type='button', data-action='delete', data-section='suppliers', data-id=item._id.toString(), data-url=`/recipes/suppliers/${item._id}/delete`) Delete
else
  .text-center.py-5.text-muted
    i.fas.fa-truck.fa-3x.mb-3.d-block.opacity-25
    p.mb-0 No suppliers yet.
    p.small Add suppliers to track where your ingredients come from.
