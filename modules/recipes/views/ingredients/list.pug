.d-flex.justify-content-between.align-items-center.mb-4
  h4.mb-0
    i.fas.fa-leaf.me-2.text-success
    | Ingredients
  button.btn.btn-primary(type='button', data-action='new-form', data-section='ingredients')
    i.fas.fa-plus.me-1
    | Add Ingredient

if ingredients && ingredients.length
  .table-responsive
    table.table.table-hover.align-middle
      thead.table-light
        tr
          th Name
          th Supplier
          th Unit
          th Cost / Unit
          th.text-end Actions
      tbody
        each item in ingredients
          tr
            td
              strong= item.name
              if item.sku
                small.text-muted.ms-2= item.sku
            td= item.supplier ? item.supplier.name : '—'
            td= item.purchaseUnit || '—'
            td= item.purchaseCost ? fmtCurrency(item.purchaseCost) : '—'
            td.text-end
              button.btn.btn-sm.btn-outline-secondary.me-1(type='button', data-action='edit-form', data-section='ingredients', data-id=item._id.toString()) Edit
              button.btn.btn-sm.btn-outline-danger(type='button', data-action='delete', data-section='ingredients', data-id=item._id.toString(), data-url=`/recipes/ingredients/${item._id}/delete`) Delete
else
  .text-center.py-5.text-muted
    i.fas.fa-leaf.fa-3x.mb-3.d-block.opacity-25
    p.mb-0 No ingredients yet.
    p.small Add your first ingredient to get started.
