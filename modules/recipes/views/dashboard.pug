extends ../../../views/layout.pug

block head
  style.
    .recipes-sidebar {
      width: 190px;
      flex-shrink: 0;
      border-right: 1px solid #dee2e6;
      padding: 1.25rem 0.75rem;
      position: sticky;
      top: 60px;
      align-self: flex-start;
    }
    .recipes-sidebar .nav-link {
      color: #495057;
      border-radius: 0.375rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .recipes-sidebar .nav-link:hover {
      background: #f8f9fa;
      color: #0d6efd;
    }
    .recipes-sidebar .nav-link.active {
      background: #e7f1ff;
      color: #0d6efd;
      font-weight: 600;
    }
    .recipes-sidebar .section-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #adb5bd;
      font-weight: 600;
      padding: 0.5rem 0.75rem 0.25rem;
    }
    #main-content {
      min-height: 60vh;
      padding: 1.5rem 0 1.5rem 2rem;
      flex: 1;
    }
    .recipes-app {
      display: flex;
      gap: 0;
      margin-top: 0.5rem;
    }

block content
  #recipes-app.recipes-app
    nav.recipes-sidebar
      p.section-label Production
      a.nav-link.sidebar-link(href='#', data-section='ingredients')
        i.fas.fa-leaf
        | Ingredients
      a.nav-link.sidebar-link(href='#', data-section='recipes')
        i.fas.fa-book-open
        | Recipes
      a.nav-link.sidebar-link(href='#', data-section='products')
        i.fas.fa-box-open
        | Products
      p.section-label.mt-3 Sourcing
      a.nav-link.sidebar-link(href='#', data-section='suppliers')
        i.fas.fa-truck
        | Suppliers

    main#main-content
      .d-flex.justify-content-center.align-items-center.py-5
        .spinner-border.text-secondary(role='status')
          span.visually-hidden Loading...

block scripts
  script(src='/js/recipes-dashboard.js?v=3')
