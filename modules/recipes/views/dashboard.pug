extends ../../../views/layout.pug

block head
  style.
    .recipes-sidebar {
      width: 190px;
      flex-shrink: 0;
      border-right: 1px solid #3a3228;
      padding: 1.25rem 0.75rem;
      position: sticky;
      top: 60px;
      align-self: flex-start;
    }
    .recipes-sidebar .nav-link {
      color: #a89a88;
      border-radius: 0.375rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .recipes-sidebar .nav-link:hover {
      background: #1a1a1a;
      color: #f4e9d8;
    }
    .recipes-sidebar .nav-link.active {
      background: #2a2318;
      color: #c24a1a;
      font-weight: 600;
    }
    .recipes-sidebar .section-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #6b4f3a;
      font-weight: 600;
      padding: 0.5rem 0.75rem 0.25rem;
    }
    #main-content {
      min-height: 60vh;
      padding: 1.5rem 0 1.5rem 2rem;
      flex: 1;
    }
    .recipes-app {
      display: flex;
      gap: 0;
      margin-top: 0.5rem;
    }

block content
  #recipes-app.recipes-app
    nav.recipes-sidebar
      p.section-label Menu
      a.nav-link.sidebar-link(href='#', data-section='products')
        i.fas.fa-box-open
        | Products
      p.section-label.mt-3 Production
      a.nav-link.sidebar-link(href='#', data-section='ingredients')
        i.fas.fa-leaf
        | Ingredients
      a.nav-link.sidebar-link(href='#', data-section='recipes')
        i.fas.fa-book-open
        | Recipes
      a.nav-link.sidebar-link(href='#', data-section='supplies')
        i.fas.fa-box
        | Supplies
      p.section-label.mt-3 Sourcing
      a.nav-link.sidebar-link(href='#', data-section='suppliers')
        i.fas.fa-truck
        | Suppliers

      p.section-label.mt-3 Config
      a.nav-link.sidebar-link(href='#', data-section='settings')
        i.fas.fa-cog
        | Settings

      hr.my-3
      details#unit-converter
        summary.small.fw-semibold.text-secondary.ps-1.mb-2(style='cursor: pointer; list-style: none; user-select: none')
          i.fas.fa-ruler-combined.me-1
          | Unit Converter
        .px-1
          .input-group.input-group-sm.mb-1
            input#uc-qty.form-control(type='number', placeholder='Qty', step='any', min='0')
            select#uc-from.form-select
              optgroup(label='Weight')
                option(value='g') g
                option(value='kg') kg
                option(value='oz') oz
                option(value='lb') lb
              optgroup(label='Volume')
                option(value='tsp') tsp
                option(value='tbsp') tbsp
                option(value='cup') cup
                option(value='fl oz') fl oz
                option(value='ml') ml
                option(value='L') L
              optgroup(label='Count')
                option(value='each') each
                option(value='dozen') dozen
          .input-group.input-group-sm
            span.input-group-text.bg-white &#8594;
            select#uc-to.form-select
              optgroup(label='Weight')
                option(value='g') g
                option(value='kg') kg
                option(value='oz') oz
                option(value='lb') lb
              optgroup(label='Volume')
                option(value='tsp') tsp
                option(value='tbsp') tbsp
                option(value='cup') cup
                option(value='fl oz') fl oz
                option(value='ml') ml
                option(value='L') L
              optgroup(label='Count')
                option(value='each') each
                option(value='dozen') dozen
          p#uc-result.text-center.small.mt-1.mb-0.text-muted —

    main#main-content
      .d-flex.justify-content-center.align-items-center.py-5
        .spinner-border.text-secondary(role='status')
          span.visually-hidden Loading...

block scripts
  script(src='/js/recipes-dashboard.js?v=12')
