- var isEdit = item != null;
- var formTitle = isEdit ? 'Edit Recipe' : 'Add Recipe';
- var formAction = isEdit ? '/recipes/recipes/' + item._id : '/recipes/recipes';
- var defaultUnit = !isEdit && settings ? settings.defaultWeightUnit || '' : '';

mixin unitSel(fname, curVal)
  select.form-select.form-select-sm(name=fname)
    option(value='') — unit —
    optgroup(label='Weight')
      each u in unitOptions.weight
        option(value=u, selected=curVal === u)= u
    optgroup(label='Volume')
      each u in unitOptions.volume
        option(value=u, selected=curVal === u)= u
    optgroup(label='Count')
      each u in unitOptions.count
        option(value=u, selected=curVal === u)= u

.d-flex.justify-content-between.align-items-center.mb-4
  h5.mb-0= formTitle
  button.btn.btn-outline-secondary.btn-sm(type='button', data-action='cancel')
    i.fas.fa-arrow-left.me-1
    | Back

form#section-form(action=formAction, method='POST')
  input(type='hidden', name='_csrf', value=_csrf)

  .row.g-3.mb-4
    .col-md-6
      label.form-label.fw-semibold(for='rc-name') Recipe Name *
      input#rc-name.form-control(type='text', name='name', value=isEdit ? item.name : '', required, placeholder='e.g. Classic Donut Base')

    .col-md-3
      label.form-label.fw-semibold(for='rc-yield') Yield
      input#rc-yield.form-control(type='number', name='yield', min='0', value=isEdit ? item.yield || '' : '', placeholder='e.g. 12')

    .col-md-3
      label.form-label.fw-semibold(for='rc-yield-unit') Yield Unit
      +unitSel('yieldUnit', isEdit ? item.yieldUnit || 'each' : 'each')

    .col-md-4
      label.form-label.fw-semibold(for='rc-shelf-life') Shelf Life (days)
      input#rc-shelf-life.form-control(type='number', name='shelfLifeDays', min='0', value=isEdit ? item.shelfLifeDays || '' : '', placeholder='e.g. 3')

    .col-12
      label.form-label.fw-semibold(for='rc-instructions') Instructions
      textarea#rc-instructions.form-control(name='instructions', rows='3', placeholder='Step-by-step preparation notes...')
        = isEdit ? item.instructions || '' : ''

  .mb-2
    .d-flex.justify-content-between.align-items-center.mb-2
      label.form-label.fw-semibold.mb-0 Ingredients
      button.btn.btn-outline-secondary.btn-sm(type='button', data-action='add-row', data-target='ingredient-rows')
        i.fas.fa-plus.me-1
        | Add Row

    .row.gx-2.text-muted.small.mb-1
      .col-4 Ingredient
      .col-2 Qty
      .col-2 Unit
      .col-3 Est. Cost
      .col-1

    #ingredient-rows
      if isEdit && item.ingredients && item.ingredients.length
        each line, idx in item.ingredients
          - var curUnit = line.unit || '';
          .row.gx-2.mb-2.item-row
            .col-4
              select.form-select.form-select-sm(name=`ingredients[${idx}][ingredient]`)
                option(value='') — Select —
                each ing in allIngredients
                  - var sel = line.ingredient && (line.ingredient._id ? line.ingredient._id.toString() : line.ingredient.toString()) === ing._id.toString();
                  option(value=ing._id, selected=sel)= ing.name
            .col-2
              input.form-control.form-control-sm(type='number', step='0.01', min='0', name=`ingredients[${idx}][quantity]`, value=line.quantity || '')
            .col-2
              +unitSel(`ingredients[${idx}][unit]`, curUnit)
            .col-3
              input.form-control.form-control-sm.bg-light.text-end(type='text', readonly, data-role='ing-cost', tabindex='-1', placeholder='—')
            .col-1
              button.btn.btn-sm.btn-outline-danger(type='button', data-action='remove-row') ×
      else
        .row.gx-2.mb-2.item-row
          .col-4
            select.form-select.form-select-sm(name='ingredients[0][ingredient]')
              option(value='') — Select —
              each ing in allIngredients
                option(value=ing._id)= ing.name
          .col-2
            input.form-control.form-control-sm(type='number', step='0.01', min='0', name='ingredients[0][quantity]')
          .col-2
            +unitSel('ingredients[0][unit]', defaultUnit)
          .col-3
            input.form-control.form-control-sm.bg-light.text-end(type='text', readonly, data-role='ing-cost', tabindex='-1', placeholder='—')
          .col-1
            button.btn.btn-sm.btn-outline-danger(type='button', data-action='remove-row') ×

  #ing-cost-data(data-costs=JSON.stringify(ingCostData || {}), style='display: none')

  //- ── Sub-Recipes Section ────────────────────────────────────────────────────
  .mb-2.mt-4
    .d-flex.justify-content-between.align-items-center.mb-2
      label.form-label.fw-semibold.mb-0 Sub-Recipes
      button.btn.btn-outline-secondary.btn-sm(type='button', data-action='add-row', data-target='subrecipe-rows')
        i.fas.fa-plus.me-1
        | Add Row

    .row.gx-2.text-muted.small.mb-1
      .col-4 Recipe
      .col-2 Qty
      .col-2 Unit
      .col-3 Est. Cost
      .col-1

    #subrecipe-rows
      if isEdit && item.subRecipes && item.subRecipes.length
        each line, idx in item.subRecipes
          - var curUnit = line.unit || '';
          .row.gx-2.mb-2.item-row.subrecipe-row
            .col-4
              select.form-select.form-select-sm(name=`subRecipes[${idx}][recipe]`, data-role='sub-recipe-ref')
                option(value='') — Select —
                each rc in allRecipes
                  if !isEdit || rc._id.toString() !== item._id.toString()
                    - var sel = line.recipe && (line.recipe._id ? line.recipe._id.toString() : line.recipe.toString()) === rc._id.toString();
                    option(value=rc._id, selected=sel)= rc.name
            .col-2
              input.form-control.form-control-sm(type='number', step='0.01', min='0', name=`subRecipes[${idx}][quantity]`, value=line.quantity || '')
            .col-2
              +unitSel(`subRecipes[${idx}][unit]`, curUnit)
            .col-3
              input.form-control.form-control-sm.bg-light.text-end(type='text', readonly, data-role='sub-cost', tabindex='-1', placeholder='—')
            .col-1
              button.btn.btn-sm.btn-outline-danger(type='button', data-action='remove-row') ×
      else
        .row.gx-2.mb-2.item-row.subrecipe-row
          .col-4
            select.form-select.form-select-sm(name='subRecipes[0][recipe]', data-role='sub-recipe-ref')
              option(value='') — Select —
              each rc in allRecipes
                if !isEdit || rc._id.toString() !== item._id.toString()
                  option(value=rc._id)= rc.name
          .col-2
            input.form-control.form-control-sm(type='number', step='0.01', min='0', name='subRecipes[0][quantity]')
          .col-2
            +unitSel('subRecipes[0][unit]', '')
          .col-3
            input.form-control.form-control-sm.bg-light.text-end(type='text', readonly, data-role='sub-cost', tabindex='-1', placeholder='—')
          .col-1
            button.btn.btn-sm.btn-outline-danger(type='button', data-action='remove-row') ×

  #sub-cost-data(data-costs=JSON.stringify(subRecipeCostData || {}), style='display: none')

  .row.g-3.mt-1
    .col-12
      label.form-label.fw-semibold(for='rc-notes') Notes
      textarea#rc-notes.form-control(name='notes', rows='2', placeholder='Optional...')
        = isEdit ? item.notes || '' : ''

  //- ── Live Cost Panel ──────────────────────────────────────────────────────
  .card.mt-4.border-primary-subtle
    .card-header.bg-primary-subtle.fw-semibold.text-primary-emphasis
      i.fas.fa-calculator.me-2
      | Cost Preview
    .card-body
      .row
        .col-md-6
          table.table.table-sm.table-borderless.mb-0
            tbody
              tr
                td Cost / Batch
                td.text-end
                  span#rc-live-batch —
              tr
                td Yield
                td.text-end
                  span#rc-live-yield —
              tr.fw-bold.border-top
                td Cost / Unit
                td.text-end
                  span#rc-live-unit —

  .mt-4.d-flex.gap-2
    button.btn.btn-primary(type='submit')
      i.fas.fa-save.me-1
      = isEdit ? 'Save Changes' : 'Add Recipe'
    button.btn.btn-outline-secondary(type='button', data-action='cancel') Cancel
