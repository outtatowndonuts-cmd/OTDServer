.d-flex.justify-content-between.align-items-center.mb-4
  h4.mb-0
    i.fas.fa-book-open.me-2.text-primary
    | Recipes
  button.btn.btn-primary(type='button', data-action='new-form', data-section='recipes')
    i.fas.fa-plus.me-1
    | Add Recipe

if recipes && recipes.length
  .table-responsive
    table.table.table-hover.align-middle
      thead.table-light
        tr
          th Name
          th Ingredients
          th Yield
          th.text-end Actions
      tbody
        each item in recipes
          tr
            td
              strong= item.name
            td
              if item.ingredients && item.ingredients.length
                each line in item.ingredients
                  span.badge.bg-light.text-dark.border.me-1= line.ingredient ? line.ingredient.name : '?'
              else
                span.text-muted —
            td= item.yield ? item.yield + ' units' : '—'
            td.text-end
              button.btn.btn-sm.btn-outline-secondary.me-1(type='button', data-action='edit-form', data-section='recipes', data-id=item._id.toString()) Edit
              button.btn.btn-sm.btn-outline-danger(type='button', data-action='delete', data-section='recipes', data-id=item._id.toString(), data-url=`/recipes/recipes/${item._id}/delete`) Delete
else
  .text-center.py-5.text-muted
    i.fas.fa-book-open.fa-3x.mb-3.d-block.opacity-25
    p.mb-0 No recipes yet.
    p.small Create a recipe to define how ingredients are combined.
