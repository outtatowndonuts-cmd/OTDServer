.d-flex.justify-content-between.align-items-center.mb-4
  h4.mb-0
    i.fas.fa-book-open.me-2.text-primary
    | Recipes
  button.btn.btn-primary(type='button', data-action='new-form', data-section='recipes')
    i.fas.fa-plus.me-1
    | Add Recipe

if recipes && recipes.length
  .table-responsive
    table.table.table-hover.align-middle
      thead.table-light
        tr
          th Name
          th Components
          th Yield
          th Cost/Batch
          th Cost/Unit
          th.text-end Actions
      tbody
        each item, idx in recipes
          - var c = costings[idx] || {};
          tr
            td
              strong= item.name
            td
              if item.ingredients && item.ingredients.length
                each line in item.ingredients
                  span.badge.bg-light.text-dark.border.me-1= line.ingredient ? line.ingredient.name : '?'
              if item.subRecipes && item.subRecipes.length
                each line in item.subRecipes
                  span.badge.bg-info.text-dark.border.me-1
                    i.fas.fa-book-open.me-1
                    = line.recipe ? line.recipe.name : '?'
              if (!item.ingredients || !item.ingredients.length) && (!item.subRecipes || !item.subRecipes.length)
                span.text-muted —
            td= item.yield ? item.yield + ' ' + (item.yieldUnit || 'each') : '—'
            td
              if c.hasIngredients
                if c.costPerBatch > 0
                  = '$' + c.costPerBatch.toFixed(2)
                  if c.missingCount
                    = ' '
                    span.badge.bg-warning.text-dark(title='Some ingredients are missing pricing') ⚠
                else
                  span.text-muted —
              else
                span.text-muted —
            td
              if c.hasIngredients
                if c.costPerUnit > 0
                  = '$' + c.costPerUnit.toFixed(4).replace(/\.?0+$/, '')
                  if c.missingCount && !c.costPerBatch
                    = ' '
                    span.badge.bg-warning.text-dark ⚠
                else
                  span.text-muted —
              else
                span.text-muted —
            td.text-end
              button.btn.btn-sm.btn-outline-secondary.me-1(type='button', data-action='edit-form', data-section='recipes', data-id=item._id.toString()) Edit
              button.btn.btn-sm.btn-outline-danger(type='button', data-action='delete', data-section='recipes', data-id=item._id.toString(), data-url=`/recipes/recipes/${item._id}/delete`) Delete
else
  .text-center.py-5.text-muted
    i.fas.fa-book-open.fa-3x.mb-3.d-block.opacity-25
    p.mb-0 No recipes yet.
    p.small Create a recipe to define how ingredients are combined.
