extends ../../../views/layout.pug

block head
  style.
    .orders-sidebar {
      width: 190px;
      flex-shrink: 0;
      border-right: 1px solid #3a3228;
      padding: 1.25rem 0.75rem;
      position: sticky;
      top: 60px;
      align-self: flex-start;
    }
    .orders-sidebar .nav-link {
      color: #a89a88;
      border-radius: 0.375rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .orders-sidebar .nav-link:hover {
      background: #1a1a1a;
      color: #f4e9d8;
    }
    .orders-sidebar .nav-link.active {
      background: #2a2318;
      color: #c24a1a;
      font-weight: 600;
    }
    .orders-sidebar .section-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #6b4f3a;
      font-weight: 600;
      padding: 0.5rem 0.75rem 0.25rem;
    }
    #main-content {
      min-height: 60vh;
      padding: 1.5rem 0 1.5rem 2rem;
      flex: 1;
    }
    .orders-app {
      display: flex;
      gap: 0;
      margin-top: 0.5rem;
    }

block content
  #orders-app.orders-app
    nav.orders-sidebar
      p.section-label Orders
      a.nav-link.sidebar-link(href='#', data-section='all')
        i.fas.fa-list
        | All Orders
      a.nav-link.sidebar-link(href='#', data-section='sales')
        i.fas.fa-cash-register
        | Sales
      a.nav-link.sidebar-link(href='#', data-section='production')
        i.fas.fa-industry
        | Production
      a.nav-link.sidebar-link(href='#', data-section='assembly')
        i.fas.fa-boxes
        | Assembly

      p.section-label.mt-3 Actions
      a.nav-link.sidebar-link(href='#', data-section='new')
        i.fas.fa-plus-circle
        | New Order

      p.section-label.mt-3 Config
      a.nav-link.sidebar-link(href='#', data-section='settings')
        i.fas.fa-cog
        | Settings

    main#main-content
      .d-flex.justify-content-center.align-items-center.py-5
        .spinner-border.text-secondary(role='status')
          span.visually-hidden Loading...

block scripts
  script(src='/js/orders-dashboard.js?v=6')
