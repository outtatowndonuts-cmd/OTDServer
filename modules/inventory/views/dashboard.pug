extends ../../../views/layout.pug

block head
  style.
    .inventory-sidebar {
      width: 190px;
      flex-shrink: 0;
      border-right: 1px solid #3a3228;
      padding: 1.25rem 0.75rem;
      position: sticky;
      top: 60px;
      align-self: flex-start;
    }
    .inventory-sidebar .nav-link {
      color: #a89a88;
      border-radius: 0.375rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .inventory-sidebar .nav-link:hover {
      background: #1a1a1a;
      color: #f4e9d8;
    }
    .inventory-sidebar .nav-link.active {
      background: #2a2318;
      color: #c24a1a;
      font-weight: 600;
    }
    .inventory-sidebar .section-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #6b4f3a;
      font-weight: 600;
      padding: 0.5rem 0.75rem 0.25rem;
    }
    #main-content {
      min-height: 60vh;
      padding: 1.5rem 0 1.5rem 2rem;
      flex: 1;
    }
    .inventory-app {
      display: flex;
      gap: 0;
      margin-top: 0.5rem;
    }

block content
  #inventory-app.inventory-app
    nav.inventory-sidebar
      p.section-label Inventory
      a.nav-link.sidebar-link(href='#', data-section='all')
        i.fas.fa-boxes-stacked
        | All Items
      a.nav-link.sidebar-link(href='#', data-section='products')
        i.fas.fa-cookie
        | Products
      a.nav-link.sidebar-link(href='#', data-section='prep')
        i.fas.fa-fire-burner
        | Prep
      a.nav-link.sidebar-link(href='#', data-section='ingredients')
        i.fas.fa-wheat-awn
        | Ingredients
      a.nav-link.sidebar-link(href='#', data-section='supplies')
        i.fas.fa-box-open
        | Supplies

      p.section-label.mt-3 Batches
      a.nav-link.sidebar-link(href='#', data-section='batches')
        i.fas.fa-layer-group
        | All Batches
      a.nav-link.sidebar-link(href='#', data-section='batches/active')
        i.fas.fa-circle-check
        | Active
      a.nav-link.sidebar-link(href='#', data-section='batches/culled')
        i.fas.fa-skull-crossbones
        | Culled

      p.section-label.mt-3 Purchase Orders
      a.nav-link.sidebar-link(href='#', data-section='purchase-orders')
        i.fas.fa-file-invoice
        | All POs
      a.nav-link.sidebar-link(href='#', data-section='purchase-orders/draft')
        i.fas.fa-pencil
        | Drafts
      a.nav-link.sidebar-link(href='#', data-section='purchase-orders/ordered')
        i.fas.fa-paper-plane
        | Ordered
      a.nav-link.sidebar-link(href='#', data-section='purchase-orders/received')
        i.fas.fa-circle-check
        | Received
      a.nav-link.sidebar-link(href='#', data-action='new-po')
        i.fas.fa-file-circle-plus
        | New PO

      p.section-label.mt-3 Actions
      a.nav-link.sidebar-link(href='#', data-action='new-po-low-stock')
        i.fas.fa-triangle-exclamation.text-warning
        | Order Low Stock
      a.nav-link.sidebar-link(href='#', data-action='sync')
        i.fas.fa-arrows-rotate
        | Sync from Orders

    main#main-content
      .d-flex.justify-content-center.align-items-center.py-5
        .spinner-border.text-secondary(role='status')
          span.visually-hidden Loading...

block scripts
  script(src='/js/inventory-dashboard.js?v=3')
