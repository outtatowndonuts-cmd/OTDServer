.d-flex.justify-content-between.align-items-center.mb-4
  h4#inventory-heading.mb-0
    i.fas.fa-boxes-stacked.me-2.text-primary
    span All Inventory

if items && items.length
  .table-responsive
    table#inventory-table.table.table-hover.align-middle
      thead.table-light
        tr
          th Name
          th Kind
          th Quantity
          th Last Updated
      tbody
        each item in items
          tr(data-kind=item.kind)
            td= item.name
            td
              if item.kind === 'product'
                span.badge.bg-success Product
              else if item.kind === 'kitchen'
                span.badge.bg-primary Prep
              else if item.kind === 'ingredient'
                span.badge.bg-info Ingredient
              else if item.kind === 'supply'
                span.badge.bg-warning.text-dark Supply
            td
              if item.quantity < 0
                span.text-danger.fw-bold= item.quantity
              else if item.quantity === 0
                span.text-warning= item.quantity
              else
                span= item.quantity
            td= item.updatedAt ? new Date(item.updatedAt).toLocaleDateString() : '—'
  #inventory-empty-filter.text-center.py-5.text-muted.d-none
    i.fas.fa-filter-circle-xmark.fa-3x.mb-3.d-block
    p No items match this filter.
else
  .text-center.py-5.text-muted
    i.fas.fa-boxes-stacked.fa-3x.mb-3.d-block
    p No inventory items found.
