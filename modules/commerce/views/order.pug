extends layout

block head
  meta(property='og:title', content='Pickup Orders — Outta Town Donuts')
  meta(property='og:description', content='Order hand-shaped donuts from Woodbury, TN for pickup.')

block content
  .otd-section
    .container
      .otd-section-header
        h1 Pickup Orders
        p.otd-text-muted Pick what you want. Quantities are real &mdash; when it&rsquo;s gone, it&rsquo;s gone.
        hr.otd-divider

      if preordersDisabled
        .otd-alert.otd-alert-warning
          | Sorry &mdash; preorders are currently turned off. Please visit the flea market to make your order with cash.
      else
        if cancelled
          .otd-alert.otd-alert-warning
            | Your payment was cancelled. Your order was not placed. You can try again below.

        if products && products.length
          #order-form
            table.otd-table
              thead
                tr
                  th Product
                  th.text-end Price
                  th.text-center Available
                  th.text-center(style='width: 140px') Qty
              tbody
                each product in products
                  tr(data-product-id=product._id, data-available=product.available, data-price=product.price, data-name=product.name)
                    td= product.name
                    td.text-end #{ fmtCurrency(product.price) }
                    td.text-center
                      if product.available > 0
                        span= product.available
                      else
                        span.otd-text-muted &mdash;
                    td.text-center
                      if product.available > 0
                        input.otd-input-qty.qty-input(type='number', min='0', max=product.available, value='0', data-ref-id=product._id, aria-label='Quantity for ' + product.name)
                      else
                        span.otd-text-muted Sold out

            .otd-mt-3(style='border-top: 1px solid var(--otd-border); padding-top: 1rem')
              .d-flex.justify-content-between.align-items-center
                div
                  span(style='font-weight: bold') Subtotal:&nbsp;
                  span#order-subtotal $0.00
                button#checkout-btn.otd-btn.otd-btn-primary(type='button', disabled) Checkout
            #order-error.otd-alert.otd-alert-error.otd-mt-2(style='display: none')
            #order-loading.otd-text-center.otd-mt-3(style='display: none')
              .otd-spinner
              p.otd-mt-1.otd-text-muted Redirecting to payment...

        else
          .otd-text-center.otd-py-5
            h3.otd-text-muted Nothing available right now.
            p.otd-text-muted Check back tomorrow morning.

      .otd-mt-4
        a.otd-text-muted(href='/shop') &larr; Back to storefront

block scripts
  script(src='/js/commerce.js')
