extends ../../../views/layout

block head
  meta(property='og:title', content='Order — Outta Town Donuts')
  meta(property='og:description', content='Order hand-shaped donuts from Woodbury, TN.')

block content
  h1 Place Your Order
  p.text-secondary Pick what you want. Quantities are real — when it's gone, it's gone.

  if cancelled
    .alert.alert-warning.mb-3
      | Your payment was cancelled. Your order was not placed. You can try again below.

  if products && products.length
    #order-form
      table.table.table-hover
        thead
          tr
            th Product
            th.text-end Price
            th.text-center Available
            th.text-center(style='width: 140px') Qty
        tbody
          each product in products
            tr(data-product-id=product._id, data-available=product.available, data-price=product.price, data-name=product.name)
              td= product.name
              td.text-end $#{ product.price.toFixed(2) }
              td.text-center
                if product.available > 0
                  span= product.available
                else
                  span.text-secondary —
              td.text-center
                if product.available > 0
                  input.form-control.form-control-sm.qty-input(type='number', min='0', max=product.available, value='0', data-ref-id=product._id, aria-label='Quantity for ' + product.name)
                else
                  span.text-secondary.small Sold out

      .border-top.pt-3.mt-3
        .d-flex.justify-content-between.align-items-center
          div
            span.fw-bold Subtotal:&nbsp;
            span#order-subtotal $0.00
          button#checkout-btn.btn.btn-primary.btn-lg(type='button', disabled) Checkout
      #order-error.alert.alert-danger.mt-3(style='display: none')
      #order-loading.text-center.mt-3(style='display: none')
        .spinner-border.text-primary(role='status')
          span.visually-hidden Placing order...
        p.mt-2 Redirecting to payment...

  else
    .text-center.py-5
      h3.text-secondary Nothing available right now.
      p Check back tomorrow morning.

  p.mt-4
    a(href='/shop') &larr; Back to storefront

block scripts
  script(src='/js/commerce.js')
