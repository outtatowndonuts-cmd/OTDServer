extends layout

block head
  meta(property='og:title', content='Custom Boxes — Outta Town Donuts')
  meta(property='og:description', content='Build your own custom donut box. Pick your flavors, we\'ll have it ready.')
  style.
    #box-flyout {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1050;
    }
    #box-flyout.open {
      display: flex;
    }
    #box-flyout-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
    }
    .box-flyout-panel {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(600px, 100vw);
      background: var(--otd-bg-card, #111);
      border-left: 1px solid var(--otd-border, #2a2a2a);
      box-shadow: -6px 0 32px rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transform: translateX(100%);
      transition: transform 0.25s ease;
    }
    #box-flyout.open .box-flyout-panel {
      transform: translateX(0);
    }
    .box-flyout-header {
      padding: 18px 24px;
      border-bottom: 1px solid var(--otd-border, #2a2a2a);
      flex-shrink: 0;
    }
    .box-flyout-body {
      flex: 1;
      overflow-y: auto;
      padding: 0 24px 16px;
    }
    .box-flyout-footer {
      padding: 16px 24px;
      border-top: 1px solid var(--otd-border, #2a2a2a);
      flex-shrink: 0;
    }
    .flyout-close-btn {
      background: none;
      border: 1px solid var(--otd-border, #2a2a2a);
      color: var(--otd-text-muted, #888);
      border-radius: 6px;
      width: 32px;
      height: 32px;
      cursor: pointer;
      font-size: 1.2rem;
      line-height: 1;
    }
    .flyout-close-btn:hover {
      border-color: #888;
      color: #fff;
    }
    .box-progress-bar-wrap {
      background: var(--otd-border, #333);
      border-radius: 8px;
      height: 6px;
      margin-top: 6px;
      overflow: hidden;
    }
    #flyout-progress-bar {
      height: 100%;
      width: 0%;
      background: var(--otd-orange, #e97320);
      border-radius: 8px;
      transition: width 0.25s;
    }
    .otd-box-option {
      cursor: pointer;
      transition: border-color 0.15s;
    }
    .otd-box-option:hover {
      border-color: var(--otd-orange, #e97320) !important;
    }
    .flyout-summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 6px;
      font-size: 0.9rem;
    }
    .flyout-summary-row.total {
      font-weight: 700;
      font-size: 1rem;
      padding-top: 8px;
      border-top: 1px solid var(--otd-border, #2a2a2a);
      margin-top: 4px;
    }

block content
  .otd-section
    .container
      .otd-section-header
        h1 Custom Boxes
        p.otd-text-muted Pick your flavors, fill your box, and we&rsquo;ll have it ready for you.
        hr.otd-divider

      if !preordersEnabled
        .otd-alert.otd-alert-warning
          | Sorry &mdash; online ordering is currently turned off. Please visit the flea market to place your order.

      else if !boxConfigs || !boxConfigs.length
        .otd-text-center.otd-py-5
          h3.otd-text-muted No custom boxes available right now.
          p.otd-text-muted Check back soon.

      else
        //- Box type cards
        #box-step-1
          h2.otd-mb-3 Choose a box
          .otd-products
            each cfg in boxConfigs
              .otd-product-card.otd-box-option(data-box-id=cfg._id, data-box-size=cfg.size, data-box-discount=cfg.discountPct, data-box-name=cfg.name)
                .otd-product-name= cfg.name
                .otd-text-muted(style='font-size: 0.85rem; margin-top: 4px')= cfg.size + ' items'
                if cfg.discountPct > 0
                  .otd-badge.otd-badge-available(style='margin-top: 6px') #{ cfg.discountPct }% off

        //- Flyout panel
        #box-flyout(aria-modal='true', role='dialog', aria-label='Build your box')
          #box-flyout-backdrop
          .box-flyout-panel
            //- Header
            .box-flyout-header
              .d-flex.align-items-start.justify-content-between
                div(style='flex: 1; min-width: 0; padding-right: 12px')
                  h2#flyout-box-name(style='margin: 0; font-size: 1.15rem')
                  .box-progress-bar-wrap
                    #flyout-progress-bar
                  span#flyout-count-label(style='font-size: 0.82rem; color: var(--otd-text-muted, #888); margin-top: 4px; display: block')
                button#flyout-close-btn.flyout-close-btn(type='button', aria-label='Close') &times;

            //- Scrollable product list
            .box-flyout-body
              if products && products.length
                table.otd-table(style='margin-top: 16px')
                  thead
                    tr
                      th Product
                      th.text-end Price
                      th.text-center In Stock
                      th.text-center(style='width: 130px') Qty
                  tbody
                    each product in products
                      if product.productType === 'simple'
                        tr(data-product-id=product._id, data-available=product.available, data-price=product.price, data-name=product.name)
                          td= product.name
                          td.text-end #{ fmtCurrency(product.price) }
                          td.text-center
                            if product.available > 0
                              span= product.available
                            else
                              span.otd-text-muted &mdash;
                          td.text-center
                            if product.available > 0
                              input.otd-input-qty.box-qty-input(type='number', min='0', max=product.available, value='0', data-ref-id=product._id, aria-label='Quantity for ' + product.name)
                            else
                              span.otd-text-muted Sold out
              else
                .otd-text-center.otd-py-5
                  h3.otd-text-muted Nothing available right now.
                  p.otd-text-muted Check back tomorrow morning.

            //- Footer: summary + checkout
            .box-flyout-footer
              .flyout-summary-row
                span Price before discount:
                span#box-gross $0.00
              .flyout-summary-row(style='color: var(--otd-orange, #e97320)')
                span#box-discount-label Discount:
                span#box-discount-amount -$0.00
              .flyout-summary-row.total
                span Total:
                span#box-total $0.00
              .otd-mt-3
                label.otd-label(for='box-pickup-name') Your name for pickup
                input#box-pickup-name.otd-input(type='text', name='pickupName', maxlength='100', placeholder='e.g. Jane Smith', autocomplete='name')
              button#box-checkout-btn.otd-btn.otd-btn-primary.otd-mt-3(type='button', style='width: 100%', disabled) Choose your items first
              #box-order-error.otd-alert.otd-alert-error.otd-mt-2(style='display: none')
              #box-order-loading.otd-text-center.otd-mt-3(style='display: none')
                .otd-spinner
                p.otd-mt-1.otd-text-muted Redirecting to payment...

      .otd-mt-4
        a.otd-text-muted(href='/shop') &larr; Back to storefront

block scripts
  script(src='/js/commerce.js')
