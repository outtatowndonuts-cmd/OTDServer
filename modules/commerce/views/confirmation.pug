extends layout

block content
  .otd-section
    .container
      .otd-confirmation
        if order.status === 'completed' && order.paymentStatus === 'paid'
          h1.otd-text-success &#10003; Order Confirmed
          p.otd-text-muted Thank you. Your order has been placed.
        else if order.status === 'pending'
          h1.otd-text-warning &#8987; Processing Payment
          p.otd-text-muted Your payment is being verified. This page will update shortly.
          meta(http-equiv='refresh', content='5')
        else if order.status === 'cancelled'
          h1.otd-text-danger Order Cancelled
          p.otd-text-muted This order was cancelled.
        else
          h1 Order Status: #{ order.status }

        .otd-confirmation-card
          h3.otd-mb-2 Order Details
          table.otd-table
            thead
              tr
                th Item
                th.text-center Qty
                th.text-end Price
            tbody
              each item in order.items
                tr
                  td= item.nameSnapshot
                  td.text-center= item.quantity
                  td.text-end $#{ (item.priceSnapshot * item.quantity).toFixed(2) }
            tfoot
              if order.subtotal != null
                tr
                  td.text-end(colspan='2') Subtotal
                  td.text-end $#{ order.subtotal.toFixed(2) }
              if order.tax != null && order.tax > 0
                tr
                  td.text-end(colspan='2') Tax
                  td.text-end $#{ order.tax.toFixed(2) }
              if order.total != null
                tr
                  td.text-end(colspan='2') Total
                  td.text-end $#{ order.total.toFixed(2) }

        .otd-mt-4
          a.otd-btn.otd-btn-outline(href='/shop') Back to Storefront
